# AlphaLens Environment Configuration

# === Application ===
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# === Groq API ===
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# Any current Groq-hosted model id works, e.g.:
# openai/gpt-oss-120b, openai/gpt-oss-20b, llama-3.3-70b-versatile, groq/compound
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=2048
GROQ_TIMEOUT=60

# === CORS ===
# BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# === Redis (optional — app degrades gracefully to no caching without it) ===
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=300

# === Database (optional — report/portfolio/eval persistence is disabled without it,
# the core analysis workflow works with zero DB configured) ===
# Must use the asyncpg driver scheme: postgresql+asyncpg://user:pass@host:port/dbname
DATABASE_URL=postgresql+asyncpg://alphalens:alphalens@localhost:5432/alphalens

# === External APIs (all optional — app falls back to yfinance / mock data) ===
# Alpha Vantage or similar: https://www.alphavantage.co/support/#api-key
FINANCIAL_DATA_API_KEY=
# NewsAPI: https://newsapi.org/register
NEWS_API_KEY=
SEC_USER_AGENT=AlphaLens Research Platform (contact@example.com)

# === Vector store (optional — falls back to in-memory Qdrant if unset/unreachable) ===
QDRANT_URL=http://localhost:6333